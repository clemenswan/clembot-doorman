# Copy to .env and fill in. Never commit .env.
#
# NOTE ON THE FILENAME: this is `env.example`, not `.env.example`, because the
# vault denies writes to `**/.env.*` at the settings level. The rule exists to
# protect real secrets and this file is a template with empty values, but a
# security rule is not something to route around quietly. Rename it locally if
# you prefer the dotted convention.
#
# Nothing here has a working default that reaches the network or a vault. An
# unconfigured doorman does less, loudly, rather than guessing.

# ── Fit review ───────────────────────────────────────────────────────────────

# Required for the fit review, which is one model call at temperature 0.
# Without it `vet` REFUSES rather than skipping fit and going straight to the
# paid grade. Skipping the free check to reach the paid one inverts the whole
# feature.
ANTHROPIC_API_KEY=

# Pinned. A fit verdict is relative to the model that produced it, the same way
# a grade is. Changing this invalidates comparison with every prior review, so
# it belongs in config rather than in a flag someone passes ad hoc.
DOORMAN_MODEL=claude-sonnet-5

# Where to read the agent inventory FROM. This repo is a giveaway: the agents,
# skills and CLAUDE.md a fit review reasons about live in whatever project you
# dropped it into, not in here. Absolute path.
# Left empty, the inventory walks up from this directory looking for a
# `.claude/agents` folder.
DOORMAN_INVENTORY_ROOT=

# ── Review notes ─────────────────────────────────────────────────────────────

# Absolute path to your Obsidian vault ROOT. Notes are written under
# <vault>/clembot-doorman/reviews/.
#
# Absolute on purpose. A relative path resolves against whatever directory the
# process started in, and in a git worktree that means writing into a tracked
# COPY of the vault, which looks completely correct and is not the vault.
#
# If this is unset or unwritable, notes fall back to registry/reviews/ with a
# warning. A report is never lost.
DOORMAN_VAULT_PATH=

# ── Scorecard ────────────────────────────────────────────────────────────────
# Read by scripts/poller.mjs today. Documented here because they were not.

SCORECARD_API=https://scorecard.wanessalabs.com
SCORECARD_OWNER=anonymous

# The scorecard's grade is model-relative; its PRICE is deployment-relative.
# Never hard-code one. `vet` asks `GET /price` and refuses to spend when the
# answer cannot be read, because a client that defaults an unknown price to
# zero passes every spend cap it has, forever.

# ── Spend cap ────────────────────────────────────────────────────────────────
#
# The doorman's second refusal, after fit. An agent that can spend money on
# your behalf while you are asleep is only as safe as the thing that says no.
#
# Caps are in USDC and both are hard. A reservation is written to
# registry/spend.ndjson BEFORE the call and only released if the call did not
# happen, so a crash over-counts the day rather than under-counting it.
#
# perRun above perDay is refused at startup: it would mean the daily cap could
# never bind, which is a limit that does not limit.
DOORMAN_MAX_USDC_PER_RUN=1
DOORMAN_MAX_USDC_PER_DAY=5
